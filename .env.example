# Sunlight runtime configuration. All values are optional; the defaults run locally.

# HTTP server
PORT=8090
HOST=0.0.0.0

# Persistent model cache. Docker compose maps the named volume to /data/cache.
CACHE_DIR=.cache/sunlight
CACHE_MAX_MB=1024

# Generation
CITY_RADIUS_M=900
GENERATION_CONCURRENCY=1
# auto | overpass | osm-api | fixture | seed
CITY_SOURCE=auto
SEEDS_ONLY=0
DEFAULT_CITY=gn-683844

# OpenStreetMap providers. Set a real contact address/URL here before deploying.
OSM_USER_AGENT=SunlightCity/0.1 (+https://example.com/sunlight)
OVERPASS_ENDPOINTS=https://overpass-api.de/api/interpreter

# Abuse protection for public deployments.
RATE_LIMIT_PER_MIN=30
